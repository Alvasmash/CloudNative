# =============================================================================
# VARIABLES DE ENTORNO DE EJEMPLO - PROYECTO CLOUD NATIVE PEDIDOS360
# Copia este archivo como .env para personalizar valores locales
# =============================================================================

# Configuración de RabbitMQ Cluster
RABBITMQ_ERLANG_COOKIE=PEDIDOS360_SECRET_COOKIE_2026
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin123

# Configuración de Autenticación IDaaS / Azure Entra ID (Microsoft Entra ID)
AZURE_TENANT_ID=16c2a7cf-f000-475f-a847-f95ee0b36404
AZURE_CLIENT_ID=c1ceeea6-1f0a-46ba-b79d-ed659608feef
JWT_ISSUER=https://login.microsoftonline.com/16c2a7cf-f000-475f-a847-f95ee0b36404/v2.0
JWT_AUDIENCE=aef48164-1df8-49e6-b9f2-c1d8953ea200

# Base de datos Cloud (Supabase / AWS RDS PostgreSQL)
# Por defecto se utiliza H2 en memoria para desarrollo local sin dependencias externas
SPRING_DATASOURCE_URL=jdbc:h2:mem:pedidosdb;DB_CLOSE_DELAY=-1;MODE=PostgreSQL
SPRING_DATASOURCE_DRIVER=org.h2.Driver
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=

# Origenes permitidos CORS (incluye frontend local y GitHub Pages)
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:80,http://localhost,https://alvasmash.github.io
